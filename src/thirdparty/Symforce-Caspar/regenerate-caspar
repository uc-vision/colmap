#!/usr/bin/env bash

set -euo pipefail

if (( $# < 2 || $# > 3 )); then
  echo "Usage: $0 OUTPUT_DIRECTORY f32|f64 [PYTHON_EXECUTABLE]" >&2
  exit 2
fi

script_directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repository_directory=$(realpath "$script_directory/../../..")
output_directory=$(realpath -m "$1")
precision=$2
python_executable=${3:-python3}
symforce_repository=https://github.com/symforce-org/symforce.git
symforce_commit=658293082085486f564ca2c7244a778d6db8278f
temporary_directory=$(mktemp -d)
trap 'rm -rf -- "$temporary_directory"' EXIT

if ! "$python_executable" - <<'PY'
import platform
import shutil
import subprocess
import sys
from importlib.metadata import version

required_packages = {
  "clang-format": "21.1.2",
  "Jinja2": "3.1.6",
  "skymarshal": "0.12.0",
  "symforce": "0.12.0",
  "symforce-sym": "0.12.0",
  "sympy": "1.14.0",
}
actual_packages = {name: version(name) for name in required_packages}
expected_python = (3, 12)
actual_python = sys.version_info[:2]
clang_format = shutil.which("clang-format")
clang_format_version = subprocess.check_output(
  [clang_format, "--version"], text=True
).strip()

if actual_python != expected_python or actual_packages != required_packages \
    or clang_format_version != "clang-format version 21.1.2":
  print("CASPAR generation requires the pinned Python 3.12 toolchain:", file=sys.stderr)
  print(f"  Python: 3.12 (found {platform.python_version()})", file=sys.stderr)
  for name, required in required_packages.items():
    print(f"  {name}: {required} (found {actual_packages[name]})", file=sys.stderr)
  print(
    f"  clang-format executable: 21.1.2 (found {clang_format_version})",
    file=sys.stderr,
  )
  raise SystemExit(2)
PY
then
  echo "Pass the pinned generator environment's Python executable as the third argument." >&2
  exit 2
fi

symforce_checkout=$temporary_directory/symforce
git init --quiet "$symforce_checkout"
git -C "$symforce_checkout" remote add origin "$symforce_repository"
git -C "$symforce_checkout" fetch --quiet --depth 1 origin "$symforce_commit"
git -C "$symforce_checkout" checkout --quiet FETCH_HEAD
git -C "$symforce_checkout" apply \
  "$script_directory/symforce-caspar-shared-constant-pool.patch"

PYTHONPATH="$symforce_checkout${PYTHONPATH:+:$PYTHONPATH}" \
  "$python_executable" "$script_directory/caspar_generate.py" \
  "$output_directory" "$precision"

# Caspar copies these support files verbatim from upstream. Preserve their
# upstream formatting while applying COLMAP's style to generated sources.
while IFS= read -r -d '' generated_file; do
  case "${generated_file##*/}" in
    shared_indices.cu|shared_indices.h|solver_params.h|solver_tools.cu|solver_tools.h|sort_indices.cu|sort_indices.h)
      continue
      ;;
  esac
  clang-format \
    "--style=file:$repository_directory/.clang-format" \
    -i "$generated_file"
done < <(find "$output_directory" -type f \
  \( -name '*.cc' -o -name '*.cu' -o -name '*.h' \) -print0)
